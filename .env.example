# Copy to .env.local and fill in. .env* is gitignored — never commit the key.

# Resend API key, from https://resend.com/api-keys
# Delivers the contact form and the footer newsletter (src/app/api/contact).
# Without it, submissions are dropped and the visitor sees a generic failure.
RESEND_API_KEY=

# Where submissions arrive. Defaults to info@exoflex.ca if unset.
CONTACT_TO=info@exoflex.ca

# Sender. Must be on a domain verified in Resend, so this only works once
# exoflex.ca is verified there (3 DNS records, under Domains).
# Before that, use Resend's sandbox sender:
#   CONTACT_FROM="ExoFlex <onboarding@resend.dev>"
# which can only deliver to the Resend account's own address — set CONTACT_TO
# to that same address while testing.
# Quoted because the angle brackets are shell redirects if anyone sources this.
CONTACT_FROM="ExoFlex <site@exoflex.ca>"
